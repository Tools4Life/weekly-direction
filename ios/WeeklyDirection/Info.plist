	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Weekly Direction shows your words on screen while you record a reflection.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Fraunces.ttf</string>
		<string>Fraunces-Italic.ttf</string>
		<string>Barlow-Regular.ttf</string>
		<string>Barlow-Medium.ttf</string>
		<string>Barlow-SemiBold.ttf</string>
		<string>BarlowCondensed-Medium.ttf</string>
		<string>BarlowCondensed-SemiBold.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
